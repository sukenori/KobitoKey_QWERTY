#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        ms_n1: mod_morph_n1 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(N1)>, <&kp N1>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ms_n2: mod_morph_n2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(N2)>, <&kp N2>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ms_n3: mod_morph_n3 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(N3)>, <&kp N3>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ms_n4: mod_morph_n4 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(N4)>, <&kp N4>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ms_n5: mod_morph_n5 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(N5)>, <&kp N5>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ms_n6: mod_morph_n6 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(N6)>, <&kp N6>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ms_n7: mod_morph_n7 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(N7)>, <&kp N7>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ms_n8: mod_morph_n8 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(N8)>, <&kp N8>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ms_n9: mod_morph_n9 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(N9)>, <&kp N9>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ms_int1: mod_morph_int1 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(INT1)>, <&kp INT1>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ms_int3: mod_morph_int3 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(INT3)>, <&kp INT3>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ms_semi: mod_morph_semi {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(SEMI)>, <&kp SEMI>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ms_apos: mod_morph_apos {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(APOS)>, <&kp APOS>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ms_equal: mod_morph_equal {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(EQUAL)>, <&kp EQUAL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ms_rbkt: mod_morph_rbkt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(RBKT)>, <&kp RBKT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ms_bslh: mod_morph_bslh {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(BSLH)>, <&kp BSLH>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

    };

    macros {
        browser_back: browser_back {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp LEFT>, <&macro_release &kp LALT>;
        };

        browser_forward: browser_forward {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp RIGHT>, <&macro_release &kp LALT>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_eisu {
            timeout-ms = <50>;
            key-positions = <12 13>;
            bindings = <&kp LANG2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q          &kp W          &kp E          &kp R        &kp T        &kp Y        &kp U        &kp I          &kp O           &kp P
&kp A          &kp S          &kp D          &kp F        &kp G        &kp H        &kp J        &kp K          &kp L           &kp MINUS
&kp Z          &kp X          &kp C          &kp V        &kp B        &kp N        &kp M        &kp COMMA      &kp DOT         &kp SLASH
&mt LSHFT ESC  &mt LCTRL TAB  &mt LALT LGUI  &lt 1 SPACE  &lt 2 INT5   &lt 2 INT4   &lt 1 RETURN &mt RALT BSPC  &mt RCTRL INS   &mt RSHFT DEL
            >;
        };

        layer1 {
            label = "NUMBER&SYMBOL";
            bindings = <
&kp N1     &kp N2     &kp N3   &kp N4  &kp N5    &kp N6  &kp N7   &kp N8       &kp N9        &kp N0
&kp F1     &kp F2     &kp F3   &kp F4  &kp F5    &kp LEFT &kp DOWN &kp UP      &kp RIGHT     &kp INT3
&kp F6     &kp F7     &kp F8   &kp F9  &kp F10   &trans  &trans   &kp SEMI     &kp APOS      &kp EQUAL
&mt LSHFT F11  &mt LCTRL F12  &kp LALT &trans  &trans    &trans  &trans   &kp RALT     &mt RCTRL RBKT &mt RSHFT BSLH
            >;
        };

        layer2 {
            label = "SHIFT_NUMBER&SYMBOL";
            bindings = <
&ms_n1   &ms_n2  &ms_n3   &ms_n4  &ms_n5     &ms_n6  &ms_n7 &ms_n8 &ms_n9 &ms_int1
&kp C_MUTE   &kp C_VOL_DN &kp C_VOL_UP &bt BT_CLR &bt BT_CLR_ALL &kp HOME    &kp END    &kp PG_UP  &kp PG_DN  &ms_int3
&kp C_BRI_UP &kp C_BRI_DN &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &trans      &kp PSCRN  &ms_semi &ms_apos &ms_equal
&kp LSHFT    &kp LCTRL   &kp LALT     &trans      &trans         &trans      &trans     &kp RALT   &mt RCTRL ms_rbkt &mt RSHFT ms_bslh
            >;
        };

        layer3 {
            label = "AUTO_MOUSE";
            bindings = <
&trans     &trans     &trans   &trans  &trans  &trans  &mkp MB1        &mkp MB2  &trans    &trans
&trans     &trans     &trans   &trans  &trans  &trans  &browser_back   &mkp MB3  &browser_forward &trans
&trans     &trans     &trans   &trans  &trans  &trans  &trans    &trans    &trans    &trans
&kp LSHFT  &kp LCTRL  &kp LALT &trans  &trans  &trans  &trans    &kp RALT  &kp RCTRL &kp RSHFT
            >;
        };
    };
};
