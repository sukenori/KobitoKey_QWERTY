#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_eisu {
            timeout-ms = <50>;
            key-positions = <12 13>;
            bindings = <&kp LANG2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q          &kp W          &kp E       &kp R          &kp T                &kp Y                &kp U          &kp I          &kp O           &kp P
&kp A          &kp S          &kp D       &kp F          &kp G                &kp H                &kp J          &kp K          &kp L           &kp SEMI
&kp Z          &kp X          &kp C       &kp V          &kp B                &kp N                &kp M          &kp COMMA      &kp DOT         &kp APOS
&mt LSHFT ESC  &mt LCTRL TAB  &kp LALT    &lt 1 SPACE    &lt 2 INTERNATIONAL5 &lt 2 INTERNATIONAL4 &lt 1 RETURN   &kp BSPC       &mt LCTRL INS   &mt RSHFT DEL
            >;
        };

        layer1 {
            label = "NUMBER_FN";
            bindings = <
&kp N1         &kp N2         &kp N3   &kp N4  &kp N5    &kp N6  &kp N7   &kp N8         &kp N9         &kp N0
&kp F1         &kp F2         &kp F3   &kp F4  &kp F5    &kp LEFT &kp DOWN &kp UP        &kp RIGHT      &trans
&kp F6         &kp F7         &kp F8   &kp F9  &kp F10   &trans  &trans   &trans         &trans         &kp CARET
&mt LSHFT F11  &mt LCTRL F12  &kp LALT &trans  &trans    &trans  &kp LALT &mt LCTRL LBKT &mt LSHFT RBKT &trans
            >;
        };

        layer2 {
            label = "SYMBOL";
            bindings = <
&kp LS(N1)  &kp LS(N2)  &kp LS(N3)     &kp LS(N4)     &kp LS(N5)         &kp LS(N6)  &kp LS(N7)  &kp LS(N8)  &kp LS(N9)  &kp LS(MINUS)
&trans      &trans      &trans         &trans         &bt BT_CLR         &kp HOME    &kp END     &kp PG_UP   &kp PG_DN   &trans
&kp C_BRI_DN &kp C_BRI_UP &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2       &kp PSCRN   &kp PLUS    &kp ASTRK   &kp TILDE   &trans
&kp LSHFT   &kp LCTRL   &kp LALT       &trans         &bt BT_CLR_ALL     &trans      &kp LALT    &kp LCTRL   &kp LSHFT   &trans
            >;
        };

        layer3 {
            label = "MOUSE";
            bindings = <
&trans     &trans  &trans    &trans    &trans  &trans  &mkp MB1  &mkp MB2  &trans    &trans
&trans     &trans  &trans    &trans    &trans  &trans  &mkp MB4  &mkp MB3  &mkp MB5  &trans
&trans     &trans  &trans    &trans    &trans  &trans  &trans    &trans    &trans    &trans
&kp LSHFT  &trans  &kp LCMD  &kp LALT  &to 0   &trans  &trans    &trans    &to 0     &kp RALT
            >;
        };
    };
};
